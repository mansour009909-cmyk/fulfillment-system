# انسخ هذا الملف إلى .env وعبّي القيم الحقيقية (لا تشارك .env الفعلي مع أحد)

# رابط اتصال PostgreSQL — استخدم قاعدة بيانات تجريبية خاصة بك، لا تتصل بقاعدة الإنتاج
DATABASE_URL="postgresql://user:password@host:port/database"

# سر توقيع جلسات تسجيل الدخول (أي نص عشوائي طويل يكفي للتطوير المحلي)
AUTH_SECRET="dev-secret-change-me"
